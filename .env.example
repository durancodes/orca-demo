# Copy to .env and adjust. Never commit a real .env.

# historical | auto | live | replay
ORCA_DATA_MODE=historical
# tauktae-2021 | michaung-2023 | calm-jan-2024
ORCA_REPLAY_EVENT=tauktae-2021

# auto | groq | gemini | anthropic | none   (auto chains every provider with a key: groq -> gemini -> anthropic)
ORCA_LLM_PROVIDER=auto
GROQ_API_KEY=
ORCA_GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
ORCA_GEMINI_MODEL=gemini-2.5-flash
# Voice input (chat mic) uses Gemini, then Whisper on Groq
ORCA_GEMINI_STT_MODEL=gemini-2.5-flash
ORCA_WHISPER_MODEL=whisper-large-v3
ANTHROPIC_API_KEY=
ORCA_ANTHROPIC_MODEL=claude-opus-5
ORCA_LLM_EFFORT=low

# Seconds between background re-evaluations of watched locations (0 disables)
ORCA_ALERT_INTERVAL_S=300

# Set when others can reach the server: gates the shared clock/replay controls (header X-Orca-Admin-Token)
ORCA_ADMIN_TOKEN=
